# FloodForge AI Frontend Configuration
# Set to your FastAPI/Python backend URL when running in API mode (e.g. http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000
# Default engine mode: "local" (in-browser deterministic screening engine) or "api"
VITE_DEFAULT_ENGINE_MODE=local
# Optional Open-Meteo endpoint override
VITE_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
